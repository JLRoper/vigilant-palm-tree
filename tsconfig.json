{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@heroes/contracts": ["./packages/contracts/src/index.ts"],
      "@heroes/contracts/*": ["./packages/contracts/src/*"],
      "@heroes/engine": ["./packages/engine/src/index.ts"],
      "@heroes/engine/*": ["./packages/engine/src/*"],
      "@screens/*": ["./src/screens/*"]
    }
  },
  "include": ["src", "packages/contracts/src", "packages/engine/src", "server"]
}
