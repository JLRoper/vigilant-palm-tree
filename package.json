{
  "name": "heroes-js",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "postinstall": "node -e \"require.resolve('playwright')\" && playwright install chromium || true",
    "cleanup": "pwsh scripts/cleanup.ps1",
    "predev": "tsx scripts/allocate-ports.ts",
    "dev": "concurrently -n web,api -c green,cyan \"vite\" \"tsx watch --env-file=.env server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:status": "pwsh scripts/dev-status.ps1",
    "pretest": "tsx scripts/allocate-ports.ts",
    "test": "tsx --env-file=.env --env-file=.env.test test/smoke.ts",
    "test:cityview": "tsx scripts/allocate-ports.ts && tsx --env-file=.env --env-file=.env.test test/cityView.test.ts",
    "test:visual": "tsx scripts/allocate-ports.ts && node --no-deprecation tools/run-test.mjs visual --auto-close",
    "test:visual:update-baselines": "tsx scripts/allocate-ports.ts && node --no-deprecation tools/run-test.mjs visual --auto-close --update-baselines",
    "test:all": "tsx scripts/allocate-ports.ts && node --no-deprecation tools/run-test.mjs all --auto-close && npm run test:unit",
    "test:multiplayer": "tsx scripts/allocate-ports.ts && node --no-deprecation tools/run-test.mjs multiplayer",
    "test:smoke": "tsx scripts/allocate-ports.ts && node --no-deprecation tools/run-test.mjs smoke --auto-close",
    "test:unit": "tsx --test test/server/*.test.ts test/persistence/*.test.ts test/migrations/*.test.ts test/render/*.test.ts test/engine/*.test.ts test/io/*.test.ts test/net/*.test.ts test/screens/**/*.test.ts",
    "test:wrapper": "node --no-deprecation tools/run-test.mjs",
    "lint:deps": "depcruise src server packages --config dependency-cruiser.cjs",
    "validate-assets": "node tools/sprites/validate-assets.mjs",
    "sprites:generate": "node tools/sprites/pixel-gen.mjs",
    "sprites:preview": "node tools/sprites/generate-preview.mjs",
    "assets:seed": "tsx --env-file=.env scripts/seed-assets.ts",
    "skybox:split": "tsx scripts/split-skybox-layers.ts",
    "migrate:jsonb-to-tables": "tsx --env-file=.env scripts/migrate-jsonb-to-tables.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.1.2",
    "dependency-cruiser": "^18.1.1",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.3.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "tsx": "^4.23.1",
    "vite": "^5.4.10"
  }
}
