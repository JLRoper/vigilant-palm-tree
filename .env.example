# heroes-js environment defaults. Copy to `.env` to override locally.
#
# NODE_ENV=development makes the local/dev environment explicit instead of
# relying on Express's implicit "development" default when this is unset.
# The deployed Docker image sets NODE_ENV=production itself (see
# docker/Dockerfile) -- don't set it to "production" here, that would
# suppress server/auth.ts's devCode convenience field for local login.
NODE_ENV=development
#
# LAN_HOST=1 binds the API to 0.0.0.0 so other machines on your network
# can join. Leave at 0 for single-machine dev (default).
LAN_HOST=0
