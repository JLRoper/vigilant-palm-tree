{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git fetch origin --quiet 2>/dev/null; true",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Fetching latest from origin..."
          }
        ]
      }
    ]
  }
}
