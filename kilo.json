{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    "docs/architecture.md",
    "src/render/docs/technical-spec.md"
  ],
  "permission": {
    "edit": {
      ".env*": "deny",
      "local/**": "deny",
      "docker-compose.yml": "ask",
      "server/migrations/**": "ask",
      "src/resources/**": "ask"
    },
    "bash": {
      "npm run db:down*": "ask",
      "npm run *": "allow",
      "npm test*": "allow",
      "npm install*": "ask",
      "git status": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git fetch*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git restore*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git reset*": "ask",
      "*": "ask"
    },
    "external_directory": "deny",
    "webfetch": "allow"
  },
  "agent": {
    "test-min": {
      "description": "Simple test",
      "mode": "subagent",
      "prompt": "You are a test agent."
    }
  }
}
