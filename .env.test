# Test-only Postgres override. Loaded AFTER .env (see the `test` script in
# package.json), so these keys win over whatever .env sets.
#
# Why this file exists: .env may point PGHOST at the shared gameserver
# (tufton-harvester) so `npm run dev` works against the live DB. The smoke
# test must never follow it there -- test/smoke.ts deletes every game in the
# database except its own two fixtures (see its "cleaned up N stale games"
# step), which against the gameserver would destroy real saves.
#
# Tests always run against the local docker-compose Postgres. Do not remove
# these lines to "make tests see live data" -- point a psql session at the
# gameserver instead.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=gameuser
PGPASSWORD=gamepass
PGDATABASE=game_poc
